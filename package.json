{
  "name": "dsh-session-folders",
  "version": "0.2.0",
  "type": "module",
  "description": "Create summary-named per-session folders in a workspace, with per-workspace UI toggles and folder inheritance for new sessions.",
  "license": "MIT",
  "author": "DieJob",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "session",
    "workspace"
  ],
  "homepage": "https://github.com/DieJob/dsh-session-folders",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DieJob/dsh-session-folders.git"
  },
  "bugs": {
    "url": "https://github.com/DieJob/dsh-session-folders/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
